{
  "name": "brave-search-mcp",
  "version": "1.0.0",
  "description": "Brave Search MCP Server for AI Assistant",
  "transport": {
    "type": "stdio"
  },
  "command": {
    "executable": "python",
    "args": ["-m", "src.mcp_integration.custom_search_server"],
    "env": {
      "BRAVE_API_KEY": "${BRAVE_API_KEY}"
    }
  },
  "tools": [
    {
      "name": "web_search",
      "description": "Search the web using Brave Search API with advanced options",
      "parameters": {
        "query": {
          "type": "string",
          "description": "Search query"
        },
        "count": {
          "type": "integer",
          "description": "Number of results (1-20)",
          "default": 10
        },
        "safesearch": {
          "type": "string",
          "enum": ["off", "moderate", "strict"],
          "default": "moderate"
        },
        "freshness": {
          "type": "string",
          "enum": ["", "pd", "pw", "pm", "py"],
          "default": ""
        },
        "country": {
          "type": "string",
          "description": "Country code (e.g., 'US', 'GB')",
          "default": ""
        }
      }
    },
    {
      "name": "search_summarize",
      "description": "Summarize and analyze search results for key insights",
      "parameters": {
        "query": {
          "type": "string",
          "description": "Search query to summarize"
        },
        "max_results": {
          "type": "integer",
          "description": "Maximum results to include",
          "default": 5
        }
      }
    },
    {
      "name": "search_analyze",
      "description": "Analyze search patterns and extract insights",
      "parameters": {
        "query": {
          "type": "string",
          "description": "Search query to analyze"
        },
        "include_domains": {
          "type": "boolean",
          "default": true
        },
        "include_keywords": {
          "type": "boolean",
          "default": true
        }
      }
    },
    {
      "name": "search_health",
      "description": "Check search service health and configuration"
    }
  ],
  "capabilities": {
    "experimental": {
      "search_caching": true,
      "search_analytics": true
    }
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  }
}